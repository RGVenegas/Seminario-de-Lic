# =============================================================================
# CONFIGURACIÓN MULTI-PROVEEDOR · SISTEMA MULTIAGENTE LANGGRAPH (CINF200 UNAB)
# =============================================================================

# 1. API OpenAI (Cuenta Profesor Guía)
#    - Rol: Respaldo de alta precisión para estructuración y fallback general.
OPENAI_API_KEY=tu_api_key_de_openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst

# 2. API Google Gemini (Cuenta Alumno)
#    - Rol: Motor principal para Fase 2 (Guion Teórico) y Fase 3 (Escaleta Audiovisual).
GEMINI_API_KEY=tu_api_key_de_gemini
GEMINI_MODEL=gemini-3.5-flash-lite

# 3. Servidor Institucional Quotas DevHub (Universidad - Modelo Gemma 4 26B)
#    - ESTADO: DESACTIVADO (para preservar cuota diaria institucional).
#    - Pon 'false' para usar OpenAI y Gemini sin consumir créditos de la universidad.
USE_INSTITUTIONAL_QUOTA=false
INSTITUTIONAL_API_KEY=tu_token_institucional
INSTITUTIONAL_BASE_URL=https://quotas.devhub.cl/api/v1
INSTITUTIONAL_MODEL=gemma4:26b
INSTITUTIONAL_MAX_TOKENS=1200

