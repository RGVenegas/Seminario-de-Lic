# Configuración Multi-Proveedor para el Sistema Multiagente

# 1. API OpenAI (Profesor Guía)
OPENAI_API_KEY=tu_api_key_de_openai
OPENAI_MODEL=gpt-4o-mini

# 2. API Google Gemini (Cuenta Alumno)
GEMINI_API_KEY=tu_api_key_de_gemini
GEMINI_MODEL=gemini-3.5-flash-lite

# 3. Servidor Institucional (Universidad - Modelo Gemma / Quotas DevHub)
# Pon 'false' para pausar el consumo institucional y guardar cuota.
USE_INSTITUTIONAL_QUOTA=false
INSTITUTIONAL_API_KEY=tu_token_institucional
INSTITUTIONAL_BASE_URL=https://quotas.devhub.cl/api/v1
INSTITUTIONAL_MODEL=gemma4:26b
INSTITUTIONAL_MAX_TOKENS=500

# 4. Anthropic Claude (Opcional - Auditoría QC)
ANTHROPIC_API_KEY=tu_api_key_de_anthropic
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
